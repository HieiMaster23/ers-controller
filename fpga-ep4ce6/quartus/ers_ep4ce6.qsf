# -------------------------------------------------------------------------- #
# Quartus II Settings File — ERS / Cyclone IV E EP4CE6E22C8
# PIN_* abaixo sao PLACEHOLDERS unicos (nao sao pinos reais da placa).
# Substitua cada um pelo pino do esquematico — ver PINOS.md
# -------------------------------------------------------------------------- #

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6E22C8
set_global_assignment -name TOP_LEVEL_ENTITY ers_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 13.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "12:50:00  SEPTEMBER 15, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION 13.0
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# ROM desta v1 = array VHDL (lap_rom_init.vhd), sem INIT_FILE.
# Quando migrar para altsyncram, usar ../stim/volta_sintetica.mif (canonico; SCALE.md).
# Nao apontar matlab/volta_sintetica.mif.

# --- VHDL sources (relative to this .qsf in quartus/) ---
set_global_assignment -name VHDL_FILE ../rtl/ers_pkg.vhd
set_global_assignment -name VHDL_FILE ../rtl/lap_rom_init.vhd
set_global_assignment -name VHDL_FILE ../rtl/lap_rom.vhd
set_global_assignment -name VHDL_FILE ../rtl/lap_seq.vhd
set_global_assignment -name VHDL_FILE ../rtl/mgu_k.vhd
set_global_assignment -name VHDL_FILE ../rtl/energy_store.vhd
set_global_assignment -name VHDL_FILE ../rtl/ers_ctrl.vhd
set_global_assignment -name VHDL_FILE ../rtl/sin_lut.vhd
set_global_assignment -name VHDL_FILE ../rtl/vga_sync.vhd
set_global_assignment -name VHDL_FILE ../rtl/dash_vga.vhd
set_global_assignment -name VHDL_FILE ../rtl/dash_leds.vhd
set_global_assignment -name VHDL_FILE ../rtl/ers_top.vhd

set_global_assignment -name VHDL_INPUT_VERSION VHDL93
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4

# --- Clock (PLACEHOLDER PIN_XX_CLK) ---
# set_location_assignment PIN_XX_CLK -to clk_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_50

# --- Reset e switches (PLACEHOLDERS) ---
# set_location_assignment PIN_XX_RST -to rst_n
# set_location_assignment PIN_XX_SW0 -to sw_start
# set_location_assignment PIN_XX_SW1 -to sw_auto_manual
# set_location_assignment PIN_XX_SW2 -to sw_deploy
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sw_start
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sw_auto_manual
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sw_deploy

# --- LEDs (PLACEHOLDERS) ---
# set_location_assignment PIN_XX_LED0 -to led[0]
# set_location_assignment PIN_XX_LED1 -to led[1]
# set_location_assignment PIN_XX_LED2 -to led[2]
# set_location_assignment PIN_XX_LED3 -to led[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[3]

# --- VGA (PLACEHOLDERS) — preencher com esquematico da placa ---
# set_location_assignment PIN_XX_HSYNC -to vga_hs
# set_location_assignment PIN_XX_VSYNC -to vga_vs
# set_location_assignment PIN_XX_R0 -to vga_r[0]
# set_location_assignment PIN_XX_R1 -to vga_r[1]
# set_location_assignment PIN_XX_R2 -to vga_r[2]
# set_location_assignment PIN_XX_R3 -to vga_r[3]
# set_location_assignment PIN_XX_G0 -to vga_g[0]
# set_location_assignment PIN_XX_G1 -to vga_g[1]
# set_location_assignment PIN_XX_G2 -to vga_g[2]
# set_location_assignment PIN_XX_G3 -to vga_g[3]
# set_location_assignment PIN_XX_B0 -to vga_b[0]
# set_location_assignment PIN_XX_B1 -to vga_b[1]
# set_location_assignment PIN_XX_B2 -to vga_b[2]
# set_location_assignment PIN_XX_B3 -to vga_b[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_hs
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_vs
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_r
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_g
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_b

set_global_assignment -name SDC_FILE ers.sdc
