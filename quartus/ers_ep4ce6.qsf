# -------------------------------------------------------------------------- #
# Quartus II Settings ? ERS demo / RZ-EasyFPGA A2.2 / EP4CE6E22C8
# Pinagem alinhada ao Vhdlboy / pedaleira / button_counter deste PC.
# -------------------------------------------------------------------------- #

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6E22C8
set_global_assignment -name TOP_LEVEL_ENTITY ers_board_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

set_global_assignment -name VHDL_FILE ../rtl/ers_pkg.vhd
set_global_assignment -name VHDL_FILE ../rtl/lap_rom_init.vhd
set_global_assignment -name VHDL_FILE ../rtl/lap_rom.vhd
set_global_assignment -name VHDL_FILE ../rtl/lap_seq.vhd
set_global_assignment -name VHDL_FILE ../rtl/track_motion.vhd
set_global_assignment -name VHDL_FILE ../rtl/mgu_k.vhd
set_global_assignment -name VHDL_FILE ../rtl/energy_store.vhd
set_global_assignment -name VHDL_FILE ../rtl/ers_ctrl.vhd
set_global_assignment -name VHDL_FILE ../rtl/sin_lut.vhd
set_global_assignment -name VHDL_FILE ../rtl/vga_sync.vhd
set_global_assignment -name VHDL_FILE ../rtl/dash_vga.vhd
set_global_assignment -name VHDL_FILE ../rtl/dash_leds.vhd
set_global_assignment -name VHDL_FILE ../rtl/ers_top.vhd
set_global_assignment -name VHDL_FILE ../rtl/ers_board_top.vhd

set_global_assignment -name VHDL_INPUT_VERSION VHDL93
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name SDC_FILE ers.sdc
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# Clock 50 MHz
set_location_assignment PIN_23 -to clk_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_50

# Reset (KEY) ativo baixo
set_location_assignment PIN_25 -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst_n

# Keys ativos baixo: 0=start/hold, 1=auto/manual, 2=deploy
set_location_assignment PIN_88 -to key_n[0]
set_location_assignment PIN_89 -to key_n[1]
set_location_assignment PIN_90 -to key_n[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to key_n[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to key_n[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to key_n[2]

# LEDs ativos baixo
set_location_assignment PIN_87 -to led[0]
set_location_assignment PIN_86 -to led[1]
set_location_assignment PIN_85 -to led[2]
set_location_assignment PIN_84 -to led[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[3]
set_instance_assignment -name CURRENT_STRENGTH_NEW "8MA" -to led[*]

# VGA 1 bit/cor (RZ-EasyFPGA A2.2)
set_location_assignment PIN_101 -to vga_hs
set_location_assignment PIN_103 -to vga_vs
set_location_assignment PIN_106 -to vga_r
set_location_assignment PIN_105 -to vga_g
set_location_assignment PIN_104 -to vga_b
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_hs
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_vs
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_r
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_g
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_b
set_instance_assignment -name CURRENT_STRENGTH_NEW "8MA" -to vga_hs
set_instance_assignment -name CURRENT_STRENGTH_NEW "8MA" -to vga_vs
set_instance_assignment -name CURRENT_STRENGTH_NEW "8MA" -to vga_r
set_instance_assignment -name CURRENT_STRENGTH_NEW "8MA" -to vga_g
set_instance_assignment -name CURRENT_STRENGTH_NEW "8MA" -to vga_b

# Libera PIN_101 (nCEO) como I/O normal ? padrao RZ-EasyFPGA A2.2 / VGA HSYNC
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"

